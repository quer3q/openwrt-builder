FROM ubuntu:latest

ENV OPENWRT_VERSION=25.12.5
ENV PROFILE=friendlyarm_nanopi-r3s
ENV PASSWALL_ARCH=aarch64_generic

RUN apt-get update -y && \
    apt-get install -y --no-install-recommends \
    sudo make build-essential file libncurses-dev zlib1g-dev gawk git \
    gettext libssl-dev xsltproc rsync wget unzip python3 zstd \
    ca-certificates && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

RUN useradd -m builder && \
    echo 'builder ALL=NOPASSWD: ALL' > /etc/sudoers.d/builder

USER builder
WORKDIR /home/builder

# Download Image Builder
RUN wget -q "https://downloads.openwrt.org/releases/${OPENWRT_VERSION}/targets/rockchip/armv8/openwrt-imagebuilder-${OPENWRT_VERSION}-rockchip-armv8.Linux-x86_64.tar.zst" && \
    tar --zstd -xf openwrt-imagebuilder-*.tar.zst && \
    mv openwrt-imagebuilder-*/ imagebuilder/ && \
    rm openwrt-imagebuilder-*.tar.zst

# Add the Passwall2 apk feed: signing key + repositories for the build,
# and the same into files/ so the router can update Passwall2 via `apk`.
RUN RELEASE="${OPENWRT_VERSION%.*}" && \
    BASE="https://sourceforge.net/projects/openwrt-passwall-build/files" && \
    wget -q -O imagebuilder/keys/passwall.pem "${BASE}/apk.pub/download" && \
    mkdir -p imagebuilder/files/etc/apk/keys imagebuilder/files/etc/apk/repositories.d && \
    cp imagebuilder/keys/passwall.pem imagebuilder/files/etc/apk/keys/passwall.pem && \
    for repo in passwall_packages passwall_luci passwall2; do \
      echo "${BASE}/releases/packages-${RELEASE}/${PASSWALL_ARCH}/${repo}/packages.adb" \
        | tee -a imagebuilder/repositories \
                 imagebuilder/files/etc/apk/repositories.d/customfeeds.list > /dev/null; \
    done

WORKDIR /home/builder/imagebuilder

# Configure partition sizes
RUN sed -i 's/CONFIG_TARGET_KERNEL_PARTSIZE=.*/CONFIG_TARGET_KERNEL_PARTSIZE=32/' .config && \
    sed -i 's/CONFIG_TARGET_ROOTFS_PARTSIZE=.*/CONFIG_TARGET_ROOTFS_PARTSIZE=512/' .config

RUN make image \
    PROFILE="${PROFILE}" \
    FILES="files" \
    PACKAGES=" \
      -dnsmasq dnsmasq-full \
      luci \
      luci-app-passwall2 xray-core \
      kmod-nft-socket kmod-nft-tproxy \
      adguardhome \
      parted losetup resize2fs \
    "
